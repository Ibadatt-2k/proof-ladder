# Database: SQLite by default, Postgres for deployment
DATABASE_URL=sqlite:///./proofladder.db
# DATABASE_URL=postgresql+psycopg://user:pass@host:5432/proofladder

# Reasoning provider: offline | anthropic | openai
#   offline   = deterministic built-in reasoner, no API key, used in CI
#   anthropic = Anthropic Messages API with tool use
#   openai    = any OpenAI-compatible endpoint (OpenAI, Gemini OpenAI-compat, Ollama)
LLM_PROVIDER=offline
LLM_MODEL=
LLM_API_KEY=
LLM_BASE_URL=
LLM_MAX_STEPS=8
LLM_MAX_COST_USD=0.05

# Corrections memory: local | qdrant
MEMORY_BACKEND=local
QDRANT_URL=
QDRANT_API_KEY=

# Demo behaviour
READONLY=false
LIVE_REPLAY=false
LIVE_REPLAY_INTERVAL_SEC=3
SEED_ON_START=600
